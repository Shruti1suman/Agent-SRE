POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=sre_agent
POSTGRES_MAINTENANCE_DATABASE=postgres
POSTGRES_INGESTION_DATABASE=sre_agent
POSTGRES_METRICS_DATABASE=sre_agent

AGENTSRE_CORS_ORIGINS=*
AGENTSRE_SESSION_TTL_DAYS=14
AGENTSRE_SESSION_PREFIX=asre_sess
AGENTSRE_SDK_KEY_PREFIX=asre_sk

AGENTSRE_METRICS_WORKER_ENABLED=true
AGENTSRE_METRICS_WORKER_INTERVAL_SECONDS=3
AGENTSRE_METRICS_WORKER_BATCH_SIZE=100
AGENTSRE_BASELINE_MIN_SAMPLES=5
AGENTSRE_ANOMALY_Z_THRESHOLD=2.5

# Gemini groundedness judge. Enabling it also requires a backend-side API key.
GEMINI_API_KEY=
AGENTSRE_LLM_JUDGE_ENABLED=false
AGENTSRE_LLM_JUDGE_API_KEY=
AGENTSRE_LLM_JUDGE_MODEL=gemini-2.5-flash
AGENTSRE_LLM_JUDGE_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AGENTSRE_LLM_JUDGE_TIMEOUT_SECONDS=20

# Gemini incident assistant. Enable this to use an LLM for incident conversations.
AGENTSRE_ASSISTANT_LLM_ENABLED=false
AGENTSRE_ASSISTANT_LLM_API_KEY=
AGENTSRE_ASSISTANT_LLM_MODEL=gemini-2.5-flash
AGENTSRE_ASSISTANT_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AGENTSRE_ASSISTANT_LLM_TIMEOUT_SECONDS=20

GOVERNANCE_BASE_URL=http://localhost:8001

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTELLIGENCE_TOPIC=intelligence.execution.trace
KAFKA_GOVERNANCE_TOPIC=governance.execution.full
